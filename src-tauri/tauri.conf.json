{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaleidoSage",
  "version": "0.3.1",
  "identifier": "com.robmirabelle.kaleidosage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14510",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kaleido Sage",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  }
}
